{
  "program": {
    "world": 4000,
    "hscale": 160,
    "sea": 0.5,
    "flood": false,
    "out": "basin",
    "nodes": [
      { "id": "broad", "op": "noise", "kind": "simplex", "freq": 5, "seed": 11 },
      { "id": "crest", "op": "fold", "kind": "ridge", "input": "broad" },
      { "id": "crags", "op": "remap", "input": "crest", "inLo": 0.15, "inHi": 0.95, "outLo": 0.5, "outHi": 1.1, "ease": "smooth" },
      { "id": "grain", "op": "noise", "kind": "simplex", "freq": 60, "seed": 4 },
      { "id": "grit", "op": "scale", "input": "grain", "by": 0.04 },
      { "id": "land", "op": "combine", "mode": "add", "a": "crags", "b": "grit" },
      { "id": "basin", "op": "clearing", "input": "land", "flat": 140, "floor": 0 }
    ]
  },
  "analysis": {
    "slopeStep": 2, "curveStep": 6, "positionRadius": 30, "occlusionRadius": 40, "occlusionSteps": 5,
    "cliffProbe": 12, "cliffSlope": 0.5, "cliffDrop": 6, "flatAngle": 0.03, "records": 50000
  },
  "ground": {
    "roughness": 0.95,
    "layers": [
      { "name": "dust", "map": "dry", "normal": "dryNormal", "scale": 6 },
      { "name": "rock", "map": "rock", "normal": "rockNormal", "scale": 10, "where": [{ "q": "slope", "lo": 0.1, "hi": 0.25 }], "edge": 0.3 }
    ]
  },
  "surfaces": {},
  "layers": []
}
